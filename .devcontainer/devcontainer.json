{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": "compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "vscode",
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/write-env.sh\" \"${localWorkspaceFolder}\"",
  "containerEnv": {
    "OPENCODE_CONFIG_CONTENT": "{\"model\":\"opencode-go/muse-spark-1.3-contributor\"}"
  },
  "mounts": [
    // Shares AGENTS.md, opencode.jsonc (MCP servers, agents) and key files.
    "source=${localEnv:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind,consistency=cached",
    // Per-container sessions/DB, surviving rebuilds.
    "source=opencode-${devcontainerId},target=/home/vscode/.local/share/opencode,type=volume"
  ],
  // Forwarding the in-container opencode port breaks the host's own service.
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide"
      ]
    }
  },
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
